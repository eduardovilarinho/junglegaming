{
  "name": "jungle-gaming",
  "version": "1.0.0",
  "description": "Avaliação Jungle Gaming: serviço financeiro de apostas (NestJS + Bun + PostgreSQL + SQS)",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:integration": "INTEGRATION=1 bun test test/integration",
    "test:multi": "INTEGRATION=1 INTEGRATION_SQS=1 bun test test/integration/multi-instancia",
    "test:load": "bun test/load/load-test.ts",
    "infra:up": "docker compose up -d postgres sqs",
    "infra:down": "docker compose down",
    "app:up": "docker compose --profile app up --build -d",
    "sqs:setup": "bun src/infrastructure/mensageria/sqs/criar-filas.ts",
    "sqs:send": "bun src/infrastructure/mensageria/sqs/enviar-transacao.ts",
    "db:migrate": "bun src/infrastructure/persistencia/mikro-orm/migrar.ts up",
    "db:migrate:down": "bun src/infrastructure/persistencia/mikro-orm/migrar.ts down",
    "db:migration:create": "bun src/infrastructure/persistencia/mikro-orm/migrar.ts create",
    "db:migration:pending": "bun src/infrastructure/persistencia/mikro-orm/migrar.ts pending"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "jose": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.9.0"
  }
}
