PORT=3000

# Autenticação: zitadel ou disabled (sem token, para testes locais)
AUTH_MODE=zitadel
ZITADEL_ISSUER=https://jungle-gaming-zyp2xj.us1.zitadel.cloud
ZITADEL_PROJECT_ID=397556188520177511

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jungle_gaming
DATABASE_DEBUG=false
DATABASE_POOL_MAX=10

# SQS local (MiniStack para testes locais)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_S=30

# Consumidor da fila, publicador do outbox e worker de pendências
WORKERS_ENABLED=true
OUTBOX_INTERVAL_MS=500
PENDING_INTERVAL_MS=1000

# Concorrência e referências pendentes
LOCK_TIMEOUT_MS=5000
PENDING_MAX_ATTEMPTS=8
PENDING_BASE_DELAY_MS=1000
PENDING_MAX_DELAY_MS=60000

# HTTPS local (opcional: gerar o certificado com o mkcert, ler readme.md)
# HTTPS_KEY=certs/localhost-key.pem
# HTTPS_CERT=certs/localhost.pem

# Testes de integraçãos
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jungle_gaming_test